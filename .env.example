# Self-healing de locators con un LLM (solo uso local, nunca en CI)
#   0       = apagado (los tests se comportan como siempre)
#   1       = repara el locator roto y sigue el test (queda anotado en el reporte)
#   sugerir = solo registra la propuesta en el reporte y en self-healing/propuestas.jsonl; el test falla igual
SELF_HEALING=0

# gemini | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Tiempo máximo de espera de la respuesta del modelo, en milisegundos
LLM_TIMEOUT_MS=20000

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 1 = guarda el último prompt enviado en self-healing/ultimo-prompt.txt (para auditar)
SELF_HEALING_DEBUG=0
